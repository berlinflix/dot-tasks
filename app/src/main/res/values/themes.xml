<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Dot" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/dot_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Splash: the dot icon on the brand background, then hand over to Theme.Dot. -->
    <style name="Theme.Dot.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/dot_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Dot</item>
    </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Microphone for on-device speech-to-text. Audio is never recorded to storage or uploaded. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Package visibility: lets SpeechRecognizer find the system's recognition service. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application>
        <!-- Opened by the widgets, the tile, the in-app mic and the launcher shortcuts. Not exported:
             shortcuts run as this app, so no other app can start it (or its microphone). -->
        <activity
            android:name=".VoiceCaptureActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="dev.suyash.dot.voice"
            android:theme="@style/Theme.Dot.Voice"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="dev.suyash.dot.action.VOICE_TASK" />
                <action android:name="dev.suyash.dot.action.TYPE_TASK" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- "Share → Dot". No UI of its own: it opens the sheet above in typing mode, where the user
             confirms before anything is saved. Reads plain text only. -->
        <activity
            android:name=".QuickCaptureActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter android:label="@string/share_to_dot">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Quick Settings tile. BIND_QUICK_SETTINGS_TILE means only the system can bind it. -->
        <service
            android:name=".VoiceTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_mic"
            android:label="@string/tile_voice_task"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
